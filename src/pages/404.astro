---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page introuvable — Halo" description="Cette page n'existe pas ou plus." noindex>
  <header class="nav">
    <a href="/" class="logo">
      <span class="logo-dot"></span>
      <span class="logo-word">Halo</span>
    </a>
  </header>

  <main class="error">
    <span class="label">(404)</span>
    <h1 class="error-title">Hors de vue.</h1>
    <p class="error-lead">
      Cette page n'existe pas, plus, ou s'est dissipée dans le flou. Vérifiez l'adresse, ou repartez de l'accueil.
    </p>
    <a href="/" class="error-back">← Retour à l'accueil</a>
  </main>
</Layout>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 10;
    display: flex;
    align-items: center;
    padding: 22px 4vw;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .logo-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1.5px solid var(--accent);
    box-shadow: 0 0 18px 4px rgba(178, 95, 62, 0.18);
    display: block;
  }
  .logo-word {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 22px;
    color: var(--ink);
  }
  .error {
    max-width: 640px;
    margin: 0 auto;
    padding: 28vh 4vw 20vh;
    min-height: 100vh;
    box-sizing: border-box;
    color: var(--ink);
  }
  .label {
    display: block;
    margin-bottom: 24px;
    color: var(--text-3);
    font-family: var(--font-mono);
  }
  .error-title {
    margin: 0 0 20px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(44px, 7vw, 80px);
    line-height: 1;
  }
  .error-lead {
    margin: 0 0 40px;
    max-width: 460px;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-2);
  }
  .error-back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid currentColor;
  }
  .error-back:hover {
    color: var(--accent);
  }
</style>
