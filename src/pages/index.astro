---
import Layout from "../layouts/Layout.astro";

const colors = [
  { id: "miel", label: "Écaille miel", swatch: "radial-gradient(circle at 35% 30%, #d9a066, #8a5226)", active: true },
  { id: "encre", label: "Encre", swatch: "radial-gradient(circle at 35% 30%, #57504a, #1e1b18)" },
  { id: "sauge", label: "Sauge", swatch: "radial-gradient(circle at 35% 30%, #b3bda5, #6f7b62)" },
  { id: "terre", label: "Terre cuite", swatch: "radial-gradient(circle at 35% 30%, #d68466, #8f4329)" },
  { id: "cristal", label: "Cristal rosé", swatch: "radial-gradient(circle at 35% 30%, #fff7f1, #e2c3b1)" },
];

const materials = [
  { id: "poli", label: "Acétate poli", sub: "Brillant, chaleureux", active: true },
  { id: "mat", label: "Acétate mat", sub: "Toucher velours" },
  { id: "titane", label: "Titane", sub: "Léger, brossé" },
];

const lenses = [
  { id: "clair", label: "Clair", sub: "Inclus", swatch: "#fbfaf7", active: true },
  { id: "ambre", label: "Ambre doux", sub: "+ 60 €", swatch: "#e2b07a" },
  { id: "fume", label: "Gris fumé", sub: "+ 60 €", swatch: "#7a746e" },
  { id: "bleu", label: "Lumière bleue", sub: "+ 40 €", swatch: "linear-gradient(135deg, #f7efd6, #c9dbe6)" },
];

const eyes = [
  { id: "od", label: "Œil droit", code: "OD" },
  { id: "og", label: "Œil gauche", code: "OG" },
];
---

<Layout title="Halo — Maison d'optique">
  <div class="page-root">
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-blob ambient-blob--1"></div>
      <div class="ambient-blob ambient-blob--2"></div>
      <div class="ambient-blob ambient-blob--3"></div>
      <div class="ambient-blob ambient-blob--4"></div>
    </div>

    <!-- NAV -->
    <header class="nav" data-nav>
    <nav class="nav-inner">
      <a href="#top" class="logo">
        <span class="logo-dot"></span>
        <span class="logo-word">Halo</span>
      </a>
      <div class="nav-links">
        <a href="#montures">Montures</a>
        <a href="#verres">Verres &amp; vision</a>
        <a href="#atelier">L'atelier</a>
        <a href="#boutique" class="accent">Rendez-vous</a>
      </div>
    </nav>
  </header>

  <main>
  <!-- HERO -->
  <section id="top" class="hero">
    <div class="hero-left">
      <div class="eyebrow-mono">Maison d'optique — Paris, depuis 1962</div>
      <h1 class="hero-h1">Voir clair, <em>en douceur.</em></h1>
      <p class="hero-p">
        Des montures façonnées à la main dans notre atelier du Marais, des verres taillés à votre regard. Une maison
        où l'on prend le temps de bien voir.
      </p>
      <div class="hero-ctas">
        <a href="#montures" class="btn btn-solid">Composer ma monture</a>
        <a href="#verres" class="btn btn-ghost">Essayer nos verres</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-halo"></div>
      <div class="hero-ring hero-ring--outer"></div>
      <div class="hero-ring hero-ring--inner"></div>
      <div id="heroGlassesHost" class="hero-glasses-host"></div>
      <div class="hero-card">
        <span class="hero-card-label">Nouveau</span>
        <span class="hero-card-name">Iris, terre cuite</span>
      </div>
    </div>
  </section>

  <div class="bandeau">
    <div class="bandeau-inner">
      <span>Acétate découpé à la main, Jura</span>
      <span class="accent">·</span>
      <span>Verres taillés sur ordonnance</span>
      <span class="accent">·</span>
      <span>Ajustage offert, à vie</span>
    </div>
  </div>

  <!-- CONFIGURATEUR -->
  <section id="montures" class="section">
    <div class="section-head">
      <div class="section-head-left">
        <div class="eyebrow-mono accent">01 — Montures sur mesure</div>
        <h2 class="h2">Composez la vôtre, <em>sous toutes ses lumières.</em></h2>
      </div>
      <p class="section-head-note">
        Teinte, matière, verre : chaque choix se reflète en direct. Faites pivoter la monture du bout des doigts.
      </p>
    </div>

    <div class="configurator">
      <div class="viewer">
        <div class="viewer-ring"></div>
        <div class="viewer-glow"></div>
        <div class="viewer-shadow"></div>
        <div id="glassesHost" class="viewer-host"></div>
        <div class="viewer-label">Vue 360° · glisser pour tourner</div>
        <div class="viewer-foot">
          <span id="modelName" class="viewer-model-name">Iris</span>
          <span id="modelRef" class="viewer-model-ref">RONDE · 48□20 · 145</span>
        </div>
      </div>

      <div class="options">
        <div class="opt-group">
          <div class="opt-label-row">
            <span class="opt-label">Teinte</span>
            <span id="colorLabel" class="opt-label-value">Écaille miel</span>
          </div>
          <div class="swatch-row">
            {
              colors.map((c) => (
                <button
                  type="button"
                  class="swatch"
                  data-color={c.id}
                  data-active={c.active ? "true" : "false"}
                  title={c.label}
                  style={`background:${c.swatch}`}
                />
              ))
            }
          </div>
        </div>

        <div class="opt-group">
          <div class="opt-label">Matière</div>
          <div class="opt-grid">
            {
              materials.map((m) => (
                <button type="button" class="opt-card" data-material={m.id} data-active={m.active ? "true" : "false"}>
                  <span class="opt-card-label">{m.label}</span>
                  <span class="opt-card-sub">{m.sub}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="opt-group">
          <div class="opt-label">Verres</div>
          <div class="opt-grid">
            {
              lenses.map((l) => (
                <button type="button" class="opt-card opt-card--lens" data-lens={l.id} data-active={l.active ? "true" : "false"}>
                  <span class="lens-swatch" style={`background:${l.swatch}`} />
                  <span class="opt-card-text">
                    <span class="opt-card-label">{l.label}</span>
                    <span class="opt-card-sub">{l.sub}</span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="opt-summary">
          <div class="opt-summary-text">
            <span id="configSummary" class="summary-line">Iris · Écaille miel · Acétate poli · verres clair</span>
            <span id="configPrice" class="summary-price">390 €</span>
          </div>
          <a href="#boutique" class="btn btn-accent">Réserver un essai</a>
        </div>
      </div>
    </div>
  </section>

  <!-- VERRES & VISION -->
  <section id="verres" class="section section--alt">
    <div class="section-head">
      <div class="section-head-left">
        <div class="eyebrow-mono accent">02 — Verres &amp; vision</div>
        <h2 class="h2">Trouvez votre netteté, <em>un œil après l'autre.</em></h2>
      </div>
      <div class="vision-intro">
        <p class="section-head-note">
          Comme dans le fauteuil de l'opticien : réglez chaque verre jusqu'à ce que la scène se pose. La correction
          est cachée — à vous de la trouver.
        </p>
        <div class="vision-actions">
          <button type="button" id="revealBtn" class="btn btn-solid btn-small">Révéler la correction</button>
          <button type="button" id="resetBtn" class="btn btn-ghost btn-small">Réinitialiser</button>
        </div>
      </div>
    </div>

    <svg width="0" height="0" style="position: absolute">
      <defs>
        {
          eyes.map((eye) =>
            ["far", "mid", "near"].map((plane) => (
              <filter id={`astig-${eye.id}-${plane}`}>
                <feGaussianBlur id={`astig-${eye.id}-${plane}-blur`} stdDeviation="0 0" />
              </filter>
            )),
          )
        }
      </defs>
    </svg>

    <div class="eyes-grid">
      {
        eyes.map((eye) => (
          <div class="eye-col">
            <div class="eye-ring">
              <div class="eye-scene">
                <div class="eye-plane eye-plane--far" data-plane="far" data-eye={eye.id}>
                  <div class="street-window">
                    <div class="street-a" />
                    <div class="street-b" />
                    <div class="street-c" />
                    <div class="street-sign">RUE DES LUNETIERS</div>
                  </div>
                  <div class="eye-chart">
                    <span>Z</span>
                    <span>U F</span>
                    <span>N C X</span>
                    <span>T Z U D</span>
                    <span>E N P O Z</span>
                    <span>D U X N C T</span>
                  </div>
                </div>
                <div class="eye-plane eye-plane--mid" data-plane="mid" data-eye={eye.id}>
                  <div class="shelf" />
                  <div class="shelf-books">
                    <span class="book book-a" /><span class="book book-b" /><span class="book book-c" /><span class="book book-d" />
                  </div>
                  <div class="shelf-vase" />
                  <div class="shelf-sphere" />
                  <div class="shelf-tag">N° 07</div>
                </div>
                <div class="eye-plane eye-plane--near" data-plane="near" data-eye={eye.id}>
                  <div class="reading-card">
                    <span class="reading-label">CARTE DE LECTURE</span>
                    <span class="reading-text">La lumière se pose sur la page, et chaque lettre retrouve sa place.</span>
                  </div>
                </div>
                <div class="eye-vignette" />
              </div>
              <div class="eye-badge">{eye.code}</div>
            </div>

            <div class="eye-controls">
              <div class="eye-controls-head">
                <span class="eye-name">{eye.label}</span>
                <span id={`eyeValue-${eye.id}`} class="eye-value">10/10</span>
              </div>
              <div class="eye-type-row" id={`eyeType-${eye.id}`}>
                <button type="button" class="opt-pill eye-type-pill" data-type="presbytie" data-active="true">Presbytie</button>
                <button type="button" class="opt-pill eye-type-pill" data-type="astigmate" data-active="false">Astigmatisme</button>
              </div>
              <input
                type="range"
                min="0"
                max="10"
                step="1"
                value="10"
                id={`eyeSlider-${eye.id}`}
                class="eye-slider"
                aria-label={`Correction ${eye.label}`}
              />
              <div class="eye-scale">
                <span>0</span><span>5</span><span>10</span>
              </div>
              <div class="eye-sharpness-row">
                <div class="eye-sharpness-track">
                  <div id={`eyeBar-${eye.id}`} class="eye-sharpness-fill" style="width: 46%" />
                </div>
                <span id={`eyeText-${eye.id}`} class="eye-sharpness-text">Netteté 46 %</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="progressive">
      <div class="progressive-text">
        <div class="eyebrow-mono accent">Le verre progressif</div>
        <h3 class="h3">Un seul verre, <em>trois distances.</em></h3>
        <p class="section-head-note">
          Le regard glisse du lointain à la lecture, sans couture. Les bords restent volontairement doux : c'est là
          que le verre se fait oublier.
        </p>
        <p class="hint-mono">Survolez la scène pour déplacer le verre.</p>
      </div>
      <div id="progLens" class="progressive-scene">
        <div class="prog-layer prog-layer--blur">
          <div class="prog-street-sign">QUAI DE LA TOURNELLE &nbsp;→&nbsp; 400 M</div>
          <div class="prog-shops">
            <span>BOULANGERIE</span><span>PHARMACIE</span><span>LIBRAIRIE</span><span>CAFÉ</span>
          </div>
          <div class="prog-clock">
            <span>MARDI 18 OCTOBRE</span>
            <span class="prog-clock-time">14 h 32 — atelier</span>
          </div>
          <div class="prog-book">
            <span>Chapitre III</span>
            <span class="prog-book-text">
              Elle posa ses lunettes sur la table, et la ville entière revint lentement, rue après rue, comme un
              paysage qu'on développe.
            </span>
          </div>
        </div>
        <div id="progLayerSharp" class="prog-layer prog-layer--sharp">
          <div class="prog-street-sign">QUAI DE LA TOURNELLE &nbsp;→&nbsp; 400 M</div>
          <div class="prog-shops">
            <span>BOULANGERIE</span><span>PHARMACIE</span><span>LIBRAIRIE</span><span>CAFÉ</span>
          </div>
          <div class="prog-clock">
            <span>MARDI 18 OCTOBRE</span>
            <span class="prog-clock-time">14 h 32 — atelier</span>
          </div>
          <div class="prog-book">
            <span>Chapitre III</span>
            <span class="prog-book-text">
              Elle posa ses lunettes sur la table, et la ville entière revint lentement, rue après rue, comme un
              paysage qu'on développe.
            </span>
          </div>
        </div>
        <div id="lensCircle" class="prog-lens-circle"></div>
        <div class="prog-labels">
          <span>Loin</span><span>Intermédiaire</span><span>Près</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ATELIER -->
  <section id="atelier" class="section">
    <div class="section-head">
      <div class="section-head-left">
        <div class="eyebrow-mono accent">03 — L'atelier</div>
        <h2 class="h2">Trois gestes, <em>une seule paire.</em></h2>
      </div>
      <p class="section-head-note">
        Chaque monture Halo passe entre les mains d'un même artisan, du premier trait au dernier réglage sur votre
        visage.
      </p>
    </div>

    <div class="atelier-grid">
      <article class="atelier-item">
        <div class="atelier-medal">
          <img src="/atelier/dessin.svg" alt="Dessin : tracé du calibre" />
        </div>
        <div class="atelier-text">
          <span class="eyebrow-mono accent">I — Le dessin</span>
          <span class="h3">Tracer à votre mesure</span>
          <p class="section-head-note">
            On relève l'écart de vos pupilles, la hauteur de vos pommettes, la largeur de votre nez. La forme naît
            de ces mesures, pas d'un catalogue.
          </p>
        </div>
      </article>
      <article class="atelier-item">
        <div class="atelier-medal">
          <img src="/atelier/decoupe.svg" alt="Découpe : plaques d'acétate" />
        </div>
        <div class="atelier-text">
          <span class="eyebrow-mono accent">II — La découpe</span>
          <span class="h3">Libérer l'acétate</span>
          <p class="section-head-note">
            La plaque, coupée dans le Jura, est fraisée, limée puis polie au tonneau pendant plusieurs jours,
            jusqu'à prendre un éclat de galet.
          </p>
        </div>
      </article>
      <article class="atelier-item">
        <div class="atelier-medal">
          <img src="/atelier/ajustage.svg" alt="Ajustage : centrage des verres" />
        </div>
        <div class="atelier-text">
          <span class="eyebrow-mono accent">III — L'ajustage</span>
          <span class="h3">Poser la lumière juste</span>
          <p class="section-head-note">
            Les verres sont centrés sur vos pupilles, puis la monture est chauffée et ajustée à votre visage. Vous
            revenez quand vous voulez, ce réglage est offert à vie.
          </p>
        </div>
      </article>
    </div>
  </section>
  </main>

  <!-- BOUTIQUE / FOOTER -->
  <footer id="boutique" class="footer">
    <div class="footer-inner">
      <div class="footer-top">
        <h2 class="footer-h2">Venez <em class="accent">voir.</em></h2>
        <div class="footer-info">
          <p class="section-head-note">14 rue de Turenne, Paris 3<sup>e</sup><br />Du mardi au samedi, 10 h – 19 h</p>
          <a href="#boutique" class="btn btn-solid">Prendre rendez-vous</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>Halo — Maison d'optique</span>
        <span>Atelier · Morez, Jura</span>
        <span>
          Modèle 3D « Glasses 08 » par <a href="https://sketchfab.com/JunkWren" target="_blank" rel="noopener noreferrer">Dokono Kinokoda</a>,
          <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>
        </span>
        <span>© 2026</span>
      </div>
    </div>
  </footer>
  </div>

  <script>
    import { initExperience } from "../scripts/experience";
    initExperience();

    const nav = document.querySelector<HTMLElement>("[data-nav]");
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      ticking = false;
      const y = window.scrollY;
      if (y <= 100) nav?.classList.remove("nav--hidden");
      else if (y > lastY) nav?.classList.add("nav--hidden");
      else if (y < lastY) nav?.classList.remove("nav--hidden");
      lastY = y;
    };
    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true },
    );
  </script>

  <style is:global>
    .page-root {
      position: relative;
      isolation: isolate;
      background: var(--bg);
    }
    .ambient-bg {
      position: fixed;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      overflow: hidden;
    }
    .ambient-blob {
      position: absolute;
      aspect-ratio: 1;
      border-radius: 50%;
      filter: blur(30px);
      will-change: transform;
    }
    .ambient-blob--1 {
      left: -10vw;
      top: -15vh;
      width: 60vw;
      background: radial-gradient(circle, rgba(255, 236, 214, 0.9) 0%, rgba(247, 243, 236, 0) 68%);
      animation: amb1 38s ease-in-out infinite;
    }
    .ambient-blob--2 {
      left: 55vw;
      top: 5vh;
      width: 50vw;
      background: radial-gradient(circle, rgba(244, 200, 170, 0.7) 0%, rgba(247, 243, 236, 0) 68%);
      animation: amb2 46s ease-in-out infinite;
    }
    .ambient-blob--3 {
      left: 20vw;
      top: 55vh;
      width: 55vw;
      background: radial-gradient(circle, rgba(255, 248, 238, 0.95) 0%, rgba(247, 243, 236, 0) 68%);
      animation: amb3 52s ease-in-out infinite;
    }
    .ambient-blob--4 {
      left: 70vw;
      top: 60vh;
      width: 38vw;
      background: radial-gradient(circle, rgba(214, 150, 115, 0.32) 0%, rgba(247, 243, 236, 0) 68%);
      animation: amb4 42s ease-in-out infinite;
    }

    .accent {
      color: var(--accent);
    }

    .nav {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(247, 243, 236, 0.82);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      transform: translateY(0);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .nav--hidden {
      transform: translateY(-100%);
    }
    .nav-inner {
      max-width: 1320px;
      margin: 0 auto;
      padding: 20px clamp(20px, 5vw, 64px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .logo-dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1.5px solid var(--accent);
      box-shadow: 0 0 18px 4px rgba(178, 95, 62, 0.18);
      display: block;
    }
    .logo-word {
      font-family: var(--font-serif);
      font-size: 30px;
      line-height: 1;
      letter-spacing: 0.01em;
      color: var(--ink);
    }
    .nav-links {
      display: flex;
      gap: clamp(18px, 3vw, 40px);
      font-size: 14px;
      letter-spacing: 0.02em;
      flex-wrap: wrap;
    }

    .eyebrow-mono {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-3);
    }
    .h2 {
      margin: 0;
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: clamp(40px, 5.4vw, 76px);
      line-height: 1;
      letter-spacing: -0.015em;
      text-wrap: balance;
    }
    .h3 {
      margin: 0;
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: clamp(32px, 3vw, 42px);
      line-height: 1;
    }

    .hero {
      max-width: 1320px;
      margin: 0 auto;
      padding: clamp(48px, 8vw, 110px) clamp(20px, 5vw, 64px) clamp(80px, 10vw, 140px);
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
      gap: clamp(48px, 6vw, 96px);
      align-items: center;
    }
    .hero-left {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }
    .hero-h1 {
      margin: 0;
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: clamp(56px, 8.4vw, 124px);
      line-height: 0.94;
      letter-spacing: -0.02em;
      text-wrap: balance;
    }
    .hero-h1 em {
      font-style: italic;
      color: var(--accent);
    }
    .hero-p {
      margin: 0;
      max-width: 440px;
      font-size: 18px;
      line-height: 1.65;
      color: var(--text-2);
      text-wrap: pretty;
    }
    .hero-ctas {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      padding-top: 8px;
    }

    .btn {
      padding: 16px 28px;
      border-radius: 999px;
      font-size: 15px;
      display: inline-flex;
      align-items: center;
      transition: all 0.25s ease;
      cursor: pointer;
    }
    .btn-small {
      padding: 11px 20px;
      font-size: 14px;
      border-radius: 999px;
    }
    .btn-solid {
      background: var(--ink);
      color: var(--bg);
      border: 1px solid var(--ink);
      box-shadow: 0 18px 40px -18px rgba(43, 39, 35, 0.45);
    }
    .btn-solid:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .btn-ghost {
      border: 1px solid var(--line-btn);
      color: var(--ink);
      background: transparent;
    }
    .btn-ghost:hover {
